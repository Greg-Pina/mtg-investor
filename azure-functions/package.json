{
  "name": "mtg-investor-functions",
  "version": "1.0.0",
  "description": "Azure Functions for MTG Investor background jobs",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "prestart": "npm run build",
