    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/storage-queue": "^12.22.0",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "mongoose": "^8.18.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "typescript": "^5.9.2"
  }
}
