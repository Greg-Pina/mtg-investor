# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/mtg-investor

# Scryfall (no key needed, but respect rate limits)
SCRYFALL_RATE_LIMIT_MS=100

# TCGPlayer (optional — falls back to CSV)
TCGPLAYER_API_KEY=
TCGPLAYER_BASE_URL=https://api.tcgplayer.com

# ManaPool (optional)
MANAPOOL_AUTH_TOKEN=
MANAPOOL_BASE_URL=

# TOA Magic (optional)
TOA_MAGIC_API_KEY=
TOA_MAGIC_BASE_URL=

# Redis (optional — disables caching if absent)
REDIS_URL=redis://localhost:6379

# Cron
SCHEDULE_INGEST=false

# JWT (required if using auth)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Alerts (optional)
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@mtg-investor.local
